{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thomasmiller-cv",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "assets": {
    "directory": "./out"
  },
  "routes": [
    {
      "pattern": "thomasmiller.cv",
      "custom_domain": true
    },
    {
      "pattern": "www.thomasmiller.cv",
      "custom_domain": true
    }
  ]
}
